# Generated by setup.sh (DATA_IP is replaced with VM-Data's private IP).
global:
  scrape_interval: 15s
scrape_configs:
  - job_name: cadvisor
    scrape_interval: 5s
    static_configs: [{targets: ["DATA_IP:8080"]}]
  - job_name: vector
    static_configs: [{targets: ["DATA_IP:9598"]}]
  - job_name: otel_hostmetrics
    static_configs: [{targets: ["DATA_IP:9599"]}]
  - job_name: otel_internal
    static_configs: [{targets: ["DATA_IP:8888"]}]
